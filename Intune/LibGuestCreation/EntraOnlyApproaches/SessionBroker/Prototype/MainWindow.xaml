<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UMD Libraries Guest Access"
    Width="520"
    Height="560"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5"
    FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!--
            The default WPF Button template overrides Background on IsMouseOver
            with the Aero highlight, which would flash this button from UMD red
            to pale blue under the cursor. Supplying a template is the only way
            to keep the brand color through every visual state.
        -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="#E21833" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#C4142B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#A21023" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#B8B8B8" />
                                <Setter Property="Cursor" Value="Wait" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E21833">
            <StackPanel Margin="36,24">
                <TextBlock
                    Text="UMD LIBRARIES"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="Library Guest Access"
                    Foreground="White"
                    FontSize="28"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Margin="34,26,34,18"
            Padding="28"
            Background="White"
            BorderBrush="#E2E2E2"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    Text="Enter the temporary credentials issued by library staff."
                    FontSize="15"
                    Foreground="#333333"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,24,0,7"
                    Text="Guest number"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <!--
                    MaxLength and ToolTip are set from broker-settings.json at
                    load time so the accepted range lives in one place. The
                    values here are only a fallback for XAML preview tools.
                -->
                <TextBox
                    x:Name="GuestNumberTextBox"
                    AutomationProperties.Name="Guest number"
                    MaxLength="11"
                    ToolTip="Enter the guest number issued by library staff" />

                <TextBlock
                    Margin="0,18,0,7"
                    Text="Password"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <PasswordBox
                    x:Name="GuestPasswordBox"
                    AutomationProperties.Name="Guest password"
                    MaxLength="256" />

                <TextBlock
                    x:Name="StatusTextBlock"
                    MinHeight="42"
                    Margin="0,16,0,6"
                    Foreground="#B00020"
                    FontSize="13"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="SignInButton"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Content="Sign in" />

                <TextBlock
                    Margin="0,14,0,0"
                    Text="Your session ends automatically when you close the application. Please sign out and take your belongings when you finish."
                    Foreground="#6A6A6A"
                    FontSize="12"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="34,0">
            <TextBlock
                VerticalAlignment="Center"
                Text="Need assistance? Please visit the library service desk."
                Foreground="#555555"
                FontSize="12"
                TextAlignment="Center" />
        </Grid>
    </Grid>
</Window>
